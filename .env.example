# Copy to .env and adjust. Never commit the real file.

# development | production | test
ENVIRONMENT=development
# SQLite by default. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+asyncpg://leads:leads@localhost:5432/leads
DATABASE_URL=sqlite+aiosqlite:///./leadcapture.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
IP_HASH_SALT=change-me-too

# Set to true only when running behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false

LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# Optional: shared rate limiting across processes.
# REDIS_URL=redis://localhost:6379/0

# Outbox / delivery
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BACKOFF_BASE_SECONDS=30
OUTBOX_BACKOFF_MAX_SECONDS=3600
OUTBOX_POLL_SECONDS=15
OUTBOX_WORKER_ENABLED=true

# SMTP notifier
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=leads@example.com
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Telegram notifier (default bot; can be overridden per form)
TELEGRAM_BOT_TOKEN=
